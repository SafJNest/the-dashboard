{
  "name": "beebot-dashboard",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "scripts": {
    "build": "qwik build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.server": "qwik check-client src dist && vite build -c adapters/vercel-edge/vite.config.ts",
    "deploy": "vercel deploy",
    "dev": "vite --mode ssr",
    "qwik": "qwik"
  },
  "dependencies": {
    "@qwik.dev/core": "2.0.0-rc.5",
    "@qwik.dev/router": "2.0.0-rc.5"
  },
  "devDependencies": {
    "@astudioplus/codegraph-mcp": "0.21.0",
    "@qwik.dev/mcp": "2.0.0-rc.5",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vercel": "^65.14.0",
    "vite": "^8.3.7"
  }
}
