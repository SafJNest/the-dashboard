{
  "version": 3,
  "routes": [
    {
      "src": "^/(.*)$",
      "has": [{ "type": "host", "value": "sounds.safjnest.com" }],
      "status": 308,
      "headers": { "Location": "https://safjnest.com/sounds/$1" }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/_qwik-router"
    }
  ]
}
